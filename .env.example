# =============================================================================
# NORSU Patient Record System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# ── Required ────────────────────────────────────────────────────────────────

# Generate a secret key: https://djecrety.ir/
# Or run:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Gmail account used to send password resets and notifications.
# You must use an App Password (requires 2FA enabled on the account).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────

# Set to True for local development (shows detailed error pages).
# Default: False
# DEBUG=True

# Comma-separated list of allowed host/domain names.
# Examples:
#   ALLOWED_HOSTS=localhost,127.0.0.1
#   ALLOWED_HOSTS=yourusername.pythonanywhere.com
# Default: (empty — only localhost allowed)
# ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: "sqlite" or "mysql". Default: sqlite
# DB_ENGINE=sqlite

# ── MySQL-only (required if DB_ENGINE=mysql) ────────────────────────────────
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
