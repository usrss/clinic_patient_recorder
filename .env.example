# ── Django Core ────────────────────────────────────────────────────────────
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=0

# Comma-separated list. For local network use the server's LAN IP, e.g.
# ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (MySQL via docker-compose service "db") ──────────────────────
DB_ENGINE=mysql
DB_NAME=clinic_db
DB_USER=cpr_user
DB_PASSWORD=change-me-to-a-strong-password
DB_ROOT_PASSWORD=change-me-to-a-strong-root-password
DB_HOST=db
DB_PORT=3306

# ── Redis (via docker-compose service "redis") ────────────────────────────
REDIS_URL=redis://redis:6379/1

# ── Email (Gmail SMTP — optional, app password required) ──────────────────
# Leave blank or unset to skip email sending (best-effort in the app).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Security overrides for local-network HTTP deployment ──────────────────
# Use 0/1 (not True/False) — python-decouple's cast=bool treats the
# literal string 'False' as truthy!
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
